+            highestGroup.SetActive(kind==4);normalGroup.SetActive(kind==3);guideGroup.SetActive(kind==5);doubleGroup.SetActive(kind==1||(kind==2&&!doubleRewardGroup));
+            if(doubleRewardGroup)doubleRewardGroup.SetActive(kind==2);
             highestTitle.text=Locale.Label("36");normalTitle.text=Locale.Label("110");guideTitle.text=Locale.Label("44");doubleTitle.text=Locale.Label(kind==1?"34":"35");
